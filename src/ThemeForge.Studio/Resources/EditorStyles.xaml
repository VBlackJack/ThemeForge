<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
 xmlns:local="clr-namespace:ThemeForge.Studio.Resources">
  <sys:Double x:Key="EditorSwatchSize">28</sys:Double>
  <sys:Double x:Key="EditorHexWidth">110</sys:Double>
  <Thickness x:Key="EditorHairline">1</Thickness>
  <Style x:Key="EditorToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Margin" Value="{DynamicResource SpacingXs}"/>
    <Setter Property="Padding" Value="{DynamicResource SpacingSm}"/>
  </Style>
  <Style x:Key="EditorHeading" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Margin" Value="{DynamicResource SpacingMd}"/>
  </Style>
  <DataTemplate x:Key="SlotItemTemplate">
    <Grid Margin="{DynamicResource SpacingXs}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource EditorHairline}" Width="{StaticResource EditorSwatchSize}" Height="{StaticResource EditorSwatchSize}"
              Margin="{DynamicResource SpacingXs}" ToolTip="{x:Static local:EditorText.Before}">
        <Border.Background><SolidColorBrush Color="{Binding OriginalColor}"/></Border.Background>
      </Border>
      <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{StaticResource EditorHairline}" Width="{StaticResource EditorSwatchSize}" Height="{StaticResource EditorSwatchSize}"
              Margin="{DynamicResource SpacingXs}" ToolTip="{x:Static local:EditorText.After}">
        <Border.Background><SolidColorBrush Color="{Binding Color}"/></Border.Background>
      </Border>
      <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" Margin="{DynamicResource SpacingMd}"/>
      <StackPanel Grid.Column="3">
        <TextBox Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                 Width="{StaticResource EditorHexWidth}" AutomationProperties.Name="{Binding Name}"
                 AutomationProperties.HelpText="{x:Static local:EditorText.HexHelp}"/>
        <TextBlock Text="{x:Static local:EditorText.InvalidColor}" Foreground="{DynamicResource ErrorBrush}"
                   TextWrapping="Wrap" Width="{StaticResource EditorHexWidth}">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsValid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></TextBlock.Style>
        </TextBlock>
      </StackPanel>
      <Button Grid.Column="4" Content="{x:Static local:EditorText.Reset}" Command="{Binding ResetCommand}"
              Style="{StaticResource EditorToolbarButton}" AutomationProperties.Name="{Binding Name}"/>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
