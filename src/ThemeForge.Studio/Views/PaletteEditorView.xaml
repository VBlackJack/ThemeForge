<UserControl x:Class="ThemeForge.Studio.Views.PaletteEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ThemeForge.Studio.Resources">
  <UserControl.Resources><ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/EditorStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  </ResourceDictionary></UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
  </UserControl.InputBindings>
  <StackPanel IsEnabled="{Binding CanEdit}">
    <TextBlock Text="{x:Static local:EditorText.Title}" FontSize="{DynamicResource FontSizeLg}" Style="{StaticResource EditorHeading}"/>
    <TextBlock Text="{x:Static local:EditorText.Description}" TextWrapping="Wrap" Margin="{DynamicResource SpacingMd}"/>
    <WrapPanel>
      <Button Content="{x:Static local:EditorText.New}" Command="{Binding NewPaletteCommand}" Style="{StaticResource EditorToolbarButton}"/>
      <Button Content="{x:Static local:EditorText.Open}" Command="{Binding OpenCommand}" Style="{StaticResource EditorToolbarButton}"/>
      <Button Content="{x:Static local:EditorText.Save}" Command="{Binding SaveCommand}" Style="{StaticResource EditorToolbarButton}"/>
      <Button Content="{x:Static local:EditorText.Export}" Command="{Binding ExportCommand}" Style="{StaticResource EditorToolbarButton}"/>
      <Button Content="{x:Static local:EditorText.Undo}" Command="{Binding UndoCommand}" Style="{StaticResource EditorToolbarButton}"/>
      <Button Content="{x:Static local:EditorText.Redo}" Command="{Binding RedoCommand}" Style="{StaticResource EditorToolbarButton}"/>
      <Button Content="{x:Static local:EditorText.ResetAll}" Command="{Binding ResetAllCommand}" Style="{StaticResource EditorToolbarButton}"/>
    </WrapPanel>
    <TextBlock Text="{Binding DocumentState}" Foreground="{DynamicResource AccentBrush}" Margin="{DynamicResource SpacingMd}"/>
    <Label Content="{x:Static local:EditorText.Name}" Target="{Binding ElementName=PaletteNameInput}" Foreground="{DynamicResource TextPrimaryBrush}"/>
    <TextBox x:Name="PaletteNameInput" Text="{Binding PaletteName, UpdateSourceTrigger=PropertyChanged}"
             AutomationProperties.Name="{x:Static local:EditorText.Name}" ToolTip="{x:Static local:EditorText.NameHint}"/>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="{DynamicResource SpacingMd}" AutomationProperties.LiveSetting="Polite"/>
    <UniformGrid Columns="2" Margin="{DynamicResource SpacingMd}">
      <Border Background="{Binding BeforeBackground}" Padding="{DynamicResource SpacingLg}">
        <StackPanel><TextBlock Text="{x:Static local:EditorText.Before}" Foreground="{Binding BeforeForeground}"/>
          <TextBlock Text="{x:Static local:EditorText.Sample}" TextWrapping="Wrap" Foreground="{Binding BeforeForeground}"/></StackPanel>
      </Border>
      <Border Background="{Binding AfterBackground}" Padding="{DynamicResource SpacingLg}">
        <StackPanel><TextBlock Text="{x:Static local:EditorText.After}" Foreground="{Binding AfterForeground}"/>
          <TextBlock Text="{x:Static local:EditorText.Sample}" TextWrapping="Wrap" Foreground="{Binding AfterForeground}"/></StackPanel>
      </Border>
    </UniformGrid>
    <CheckBox Content="{x:Static local:EditorText.Original}" IsChecked="{Binding ShowOriginal}" Margin="{DynamicResource SpacingMd}"/>
    <TextBlock Text="{x:Static local:EditorText.Canonical}" Style="{StaticResource EditorHeading}"/>
    <ItemsControl ItemsSource="{Binding CanonicalSlots}" ItemTemplate="{StaticResource SlotItemTemplate}"/>
    <TextBlock Text="{x:Static local:EditorText.Semantic}" Style="{StaticResource EditorHeading}"/>
    <ItemsControl ItemsSource="{Binding SemanticSlots}" ItemTemplate="{StaticResource SlotItemTemplate}"/>
    <TextBlock Text="{x:Static local:EditorText.Extended}" Style="{StaticResource EditorHeading}"/>
    <ItemsControl ItemsSource="{Binding ExtendedSlots}" ItemTemplate="{StaticResource SlotItemTemplate}"/>
    <TextBlock Text="{x:Static local:EditorText.Diagnostics}" Style="{StaticResource EditorHeading}"/>
    <ItemsControl ItemsSource="{Binding Contrasts}"><ItemsControl.ItemTemplate><DataTemplate>
      <WrapPanel Margin="{DynamicResource SpacingXs}"><TextBlock Text="{Binding Pair}"/>
        <TextBlock Text="{Binding Ratio, StringFormat=F2}" Margin="{DynamicResource SpacingXs}"/>
        <TextBlock Text="{Binding Result}"/></WrapPanel>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="{x:Static local:EditorText.Attribution}" Style="{StaticResource EditorHeading}"/>
    <TextBlock Text="{Binding Attribution}" TextWrapping="Wrap"/>
  </StackPanel>
</UserControl>
